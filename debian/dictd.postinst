#!/bin/sh
# vim: ts=4:et:sts=4
# $Id: dictd.postinst 24 2008-01-20 10:15:09Z robert $

set -e

PACKAGE=dictd

case "$1" in 
     configure)
        if [ -e /etc/dictd.conf.moved_by_preinst ]; then 
            rm /etc/dictd.conf.moved_by_preinst;
        fi
        if [ -x /usr/sbin/dictdconfig ]; then dictdconfig -w ; fi

        ;;

    failed-upgrade|abort-upgrade|abort-remove|abort-deconfigure|in-favour|removing)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2;
        exit 1;
        ;;
esac

#DEBHELPER#
