msgid "disabled"
msgstr "wyłączony"

#. Type: select
#. Description
#: ../dictd.templates:1002
msgid "How do you want to run dictd?"
msgstr "W jakim trybie ma działać dictd?"

#
#. Type: select
#. Description
#: ../dictd.templates:1002
#| msgid ""
#| "The dictd server can run as a standalone daemon or from inetd. It can "
#| "also can be entirely disabled."
msgid ""
"The dictd server can be run either as a stand-alone daemon or from inetd. "
"You can also disable it entirely."
msgstr ""
"Serwer dictd może być uruchomiany albo jako samodzielny demon, albo przez serwer inetd. "
"Można go też całkowicie wyłączyć."

#
#. Type: select
#. Description
#: ../dictd.templates:1002
#| msgid "Running in daemon mode is the recommended approach."
msgid "Running in the daemon mode is the recommended approach."
msgstr "Zalecane jest uruchamianie w trybie demona."

