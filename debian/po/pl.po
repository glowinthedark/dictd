#
#. Type: select
#. Description
#: ../dictd.templates:1002
msgid ""
"The dictd server can run as a standalone daemon or from inetd. It can also "
"can be entirely disabled."
msgstr ""
"Serwer dictd może być uruchomiony jako samodzielny demon lub być uruchamiany "
"przez serwer inetd. Można go też całkowicie wyłączyć."

#
#. Type: select
#. Description
#: ../dictd.templates:1002
msgid "Running in daemon mode is the recommended approach."
msgstr "Zalecane jest uruchamianie w trybie demona."
