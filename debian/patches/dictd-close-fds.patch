Close all file descriptors except for the standard ones not to hang
dpkg-reconfigure

Index: dictd/dictd.c
===================================================================
--- dictd.orig/dictd.c	2011-01-23 10:07:57.000000000 +0100
+++ dictd/dictd.c	2011-01-23 10:08:16.000000000 +0100
@@ -1529,6 +1529,10 @@
       { 0,                  0, 0, 0  }
    };
 
+   /* close all file descriptors except for the standard ones */
+   for (i=getdtablesize()-1; i > 2; --i)
+ 	close(i);
+
    set_umask ();
    init (argv[0]);
 
