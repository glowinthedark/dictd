Fix invalid definition on uint32 type on 64-bit systems (except for alpha), 
which caused failures when 64-bit dict client tried to authenticate a user
against 32-bit dictd server (closes: #611203).

Index: dictd/md5.h
===================================================================
--- dictd.orig/md5.h	2008-04-01 22:55:37.000000000 +0200
+++ dictd/md5.h	2011-01-28 23:39:40.000000000 +0100
@@ -1,11 +1,8 @@
 #ifndef MD5_H
 #define MD5_H
 
-#ifdef __alpha
-typedef unsigned int uint32;
-#else
-typedef unsigned long uint32;
-#endif
+#include <stdint.h>
+typedef uint32_t uint32;
 
 struct MD5Context {
 	uint32 buf[4];
