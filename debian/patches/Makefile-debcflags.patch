Add $(DEBCFLAGS), remove -O* from CFLAGS in order to support
DEB_BUILD_FLAGS variable in debian/rules

Index: dictd/Makefile.in
===================================================================
--- dictd.orig/Makefile.in	2008-01-23 22:50:53.000000000 +0100
+++ dictd/Makefile.in	2008-01-23 22:55:29.000000000 +0100
@@ -75,7 +75,7 @@
 JUDYLIB=        @JUDYLIB@
 DBILIB=         @DBILIB@
 
-CFLAGS= @CPPFLAGS@ @DEFS@ @CFLAGS@ -DDICT_PLUGIN_PATH=\"$(PLUGIN_DIR)\" -DDICT_DICTIONARY_PATH=\"$(DICT_DIR)\" -DDICT_VERSION=\"$(DICT_VERSION)\" -DDICT_CONFIG_PATH=\"$(CONF_DIR)\" -I.
+CFLAGS= @CPPFLAGS@ @DEFS@ $(filter-out -O%, @CFLAGS@) $(DEBCFLAGS) -DDICT_PLUGIN_PATH=\"$(PLUGIN_DIR)\" -DDICT_DICTIONARY_PATH=\"$(DICT_DIR)\" -DDICT_VERSION=\"$(DICT_VERSION)\" -DDICT_CONFIG_PATH=\"$(CONF_DIR)\" -I.
 
 LDFLAGS=        @LDFLAGS@ @LIBS@
 LIBOBJS=        @LIBOBJS@
Index: dictd/libmaa/Makefile.in
===================================================================
--- dictd.orig/libmaa/Makefile.in	2008-01-23 22:55:47.000000000 +0100
+++ dictd/libmaa/Makefile.in	2008-01-23 22:56:47.000000000 +0100
@@ -53,7 +53,7 @@
 AWK=            @AWK@
 
 VERCFLAGS=       -DMAA_MAJOR=$(MAA_MAJOR) -DMAA_MINOR=$(MAA_MINOR)
-CFLAGS=		@DEFS@ @CPPFLAGS@ @CFLAGS@ $(VERCFLAGS) -I.
+CFLAGS=		@DEFS@ @CPPFLAGS@ $(filter-out -O%, @CFLAGS@ ) $(DEBCFLAGS) $(VERCFLAGS) -I.
 LDFLAGS=        @LDFLAGS@ @LIBS@ .libs/libmaa.a -lm
 RPATHFLAGS=     @RPATHFLAGS@
 
