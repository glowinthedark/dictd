#! /bin/sh
set -e

case "$1" in 
configure)
       rm -f /etc/dict.conf.moved_by_preinst;
       ;;

abort-upgrade|abort-remove|abort-deconfigure)
       # No prerm script, so no need to roll back
       ;;

*)
       echo "postinst called with unknown argument \`$1'" >&2;
       exit 1;
       ;;
esac
